---
Checks: "-*,readability-identifier-naming"
FormatStyle: file
WarningsAsErrors: "*"
CheckOptions:
  # Types (Classes, Structs, Enums, Typedefs, Concepts)
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  # StructCase is intentionally unchecked:
  # currently, it can be type trait (e.g. std::is_enum like) but also
  # a plain data struct like struct Point{}
  readability-identifier-naming.StructCase: aNy_CasE
  readability-identifier-naming.UnionCase: CamelCase
  # Intentionally unchecked, to handle properly both std and us4us defined types.
  readability-identifier-naming.TypeAliasCase: aNy_CasE
  readability-identifier-naming.TypedefCase: CamelCase
  # Concepts mirror the standard library (std::same_as, std::formattable).
  readability-identifier-naming.ConceptCase: lower_case

  # Functions and Methods
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.ConstexprFunctionCase: camelBack
  readability-identifier-naming.ConstexprMethodCase: camelBack

  # Variables (Locals, Globals, Parameters, Members)
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.MemberPrefix: ""
  readability-identifier-naming.MemberSuffix: ""
  readability-identifier-naming.GlobalVariableCase: camelBack
  readability-identifier-naming.StaticVariableCase: camelBack

  # Constants and Enum Constants
  # LLVM generally avoids ALL_CAPS for constants/enumerators to prevent macro clashes
  readability-identifier-naming.ConstantCase: UPPER_CASE
  # Relaxing constraints here: Trait members follow std (e.g. safe_sizeof<T>::value), and constexpr.
  readability-identifier-naming.ClassConstantCase: aNy_CasE
  readability-identifier-naming.LocalConstantCase: aNy_CasE
  readability-identifier-naming.EnumConstantCase: UPPER_CASE
  readability-identifier-naming.ScopedEnumConstantCase: UPPER_CASE
  readability-identifier-naming.ConstantParameterCase: camelBack

  # Namespaces
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.InlineNamespaceCase: lower_case

  # Templates
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateTemplateParameterCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: CamelCase
