#pragma once

#include <concepts>
#include <cstddef>
#include <type_traits>

namespace nson::internal::math {

template<typename T, T Base, std::size_t Exp, bool FirstInvocation = true>
    requires(std::is_integral_v<T>)
struct pow_impl {
    static constexpr T value = Base * pow_impl<T, Base, Exp - 1, false>::value;
};

template<typename T, T Base>
struct pow_impl<T, Base, 0, false> {
    static constexpr T value = Base;
};

template<typename T, T Base>
struct pow_impl<T, Base, 0, true> {
    static constexpr T value = static_cast<T>(1);
};

};// namespace nson::internal::math