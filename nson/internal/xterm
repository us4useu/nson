#pragma once

#include <format>
#include <string>
#include <string_view>

namespace nson::xterm {

namespace cursor {
inline std::string moveTo(size_t row, size_t col) { return std::format("\033[{};{}H", row, col); }
inline constexpr std::string_view home() { return "\033[H"; }
inline std::string moveUp(size_t n = 1) { return std::format("\033[{}A", n); }
inline std::string moveDown(size_t n = 1) { return std::format("\033[{}B", n); }
inline std::string moveRight(size_t n = 1) { return std::format("\033[{}C", n); }
inline std::string moveLeft(size_t n = 1) { return std::format("\033[{}D", n); }
}// namespace cursor

namespace erase {
inline constexpr std::string_view below() { return "\033[0J"; }
inline constexpr std::string_view above() { return "\033[1J"; }
inline constexpr std::string_view all() { return "\033[2J"; }
inline constexpr std::string_view right() { return "\033[0K"; }
inline constexpr std::string_view left() { return "\033[1K"; }
inline constexpr std::string_view line() { return "\033[2K"; }
}// namespace erase

}// namespace nson::xterm