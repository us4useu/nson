#pragma once

#include <cstddef>
#include <type_traits>

namespace nson::void_safe {

/**
 * UnaryTypeTrait to get the reference of type T, if possible, or std::nullptr_t as a fallback.
 */
template<typename T> struct reference {
    using type = T &;
};
template<> struct reference<void> {
    using type = std::nullptr_t;
};
template<> struct reference<std::nullptr_t> {
    using type = std::nullptr_t;
};
template<typename T> using reference_t = typename reference<T>::type;

/**
 * UnaryTypeTrait to get the size of type T, if possible, or 0 as a fallback.
 */
template<typename T> struct safe_sizeof {
    static constexpr std::size_t value = sizeof(T);
};
template<> struct safe_sizeof<void> {
    static constexpr std::size_t value = 0;
};
template<> struct safe_sizeof<std::nullptr_t> {
    static constexpr std::size_t value = 0;
};
// NOLINTNEXTLINE(readability-identifier-naming)
template<typename T> constexpr std::size_t safe_sizeof_v = safe_sizeof<T>::value;

};// namespace nson::void_safe